# ==============================================================================
# Social Guard: Backend Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS
SECRET_KEY=change-this-in-production-use-a-strong-random-key
ALLOWED_ORIGINS=["chrome-extension://*", "http://localhost:3000", "http://localhost:8000"]

# Google Fact Check Tools API Key
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/social_guard_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/social_guard_db

# ML / NLP Model Settings
SBERT_MODEL_NAME=all-MiniLM-L6-v2
DEVICE=cpu

# Module Weights Configuration (Must sum to 1.0)
WEIGHT_COMMENTS=0.20
WEIGHT_EVIDENCE=0.40
WEIGHT_USER_BEHAVIOUR=0.15
WEIGHT_SIMILAR_CONTENT=0.25

{
  "manifest_version": 3,
  "name": "Social Guard: Explainable AI Verification",
  "version": "1.0.0",
  "description": "Explainable AI framework for social media credibility assessment and synthetic content detection.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Social Guard Credibility Analysis"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.reddit.com/*",
        "https://*.instagram.com/*"
      ],
      "js": ["content/content_extractor.js"],
      "run_at": "document_idle"
    }
  ]
}
